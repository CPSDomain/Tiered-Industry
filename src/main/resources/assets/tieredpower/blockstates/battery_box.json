    {
      "when": {
        "east": "output"
      },
      "apply": {
        "model": "tieredpower:block/battery_box_output",
        "y": 90
      }
    },
    {
      "when": {
        "east": "disabled"
      },
      "apply": {
        "model": "tieredpower:block/battery_box_disabled",
        "y": 90
      }
    },
    {
      "when": {
        "south": "input"
      },
      "apply": {
        "model": "tieredpower:block/battery_box_input",
        "y": 180
      }
